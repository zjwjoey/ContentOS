NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://contentos_dev:change-me@127.0.0.1:55433/contentos_operator_dev
CONTENTOS_OPERATOR_DATABASE_URL=postgresql://contentos_dev:change-me@127.0.0.1:55433/contentos_operator_dev
CONTENTOS_TEST_DATABASE_URL=postgresql://contentos_dev:change-me@127.0.0.1:55433/contentos_test
# Optional local test URL; migration matrix uses isolated schemas and does not require CREATEDB.
CONTENTOS_TEST_ADMIN_DATABASE_URL=postgresql://contentos_dev:change-me@127.0.0.1:55433/contentos_test
STORAGE_ROOT=./storage/local
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_FONT_FILE=C:\Windows\Fonts\msyh.ttc
LOG_LEVEL=info
VIDEO_WORKER_CONCURRENCY=1
ASSET_WORKER_CONCURRENCY=1
ASSET_UPLOAD_MAX_BYTES=524288000
ASSET_UPLOAD_STAGING_ROOT=storage/staging
PUBLISHER_WORKER_CONCURRENCY=1
# Real platform adapters stay disabled unless explicitly enabled in a controlled environment.
PUBLISHER_REAL_ADAPTERS_ENABLED=0
PUBLISHER_WECHAT_ALLOW_SUBMIT=0
PUBLISHER_WECHAT_HEADED=1
PUBLISHER_PROFILE_ROOT=storage/publisher-profiles
PUBLISHER_EVIDENCE_ROOT=artifacts/publisher
# Optional server-side external video provider. Never expose this key to the browser.
PEXELS_API_KEY=
# Set to 1 only for local deterministic browser/integration tests.
CONTENTOS_FAKE_PEXELS=0
CONTENTOS_FAKE_PEXELS_FIXTURE=
# Digital Human V1
CONTENTOS_AI_RUNTIME_ROOT=F:\ContentOS-AI
CONTENTOS_SPEECH_PROVIDER=indextts25
CONTENTOS_INDEXTTS_BASE_URL=http://127.0.0.1:8788
CONTENTOS_AVATAR_PROVIDER=hzagent
# AvatarProvider is intentionally interface-only until the official vendor API contract is supplied.
# Provider media staging uses the built-in signed URL boundary.
CONTENTOS_MEDIA_STAGING_PROVIDER=signed-url
CONTENTOS_MEDIA_STAGING_BASE_URL=
CONTENTOS_MEDIA_STAGING_SECRET=
CONTENTOS_PROVIDER_REQUEST_TIMEOUT_MS=30000
CONTENTOS_PROVIDER_CAPABILITY_TIMEOUT_MS=5000
CONTENTOS_AVATAR_RESULT_TIMEOUT_MS=300000
DIGITAL_HUMAN_WORKER_CONCURRENCY=1
DIGITAL_HUMAN_POLL_INTERVAL_MS=250

# Optional Qwen configuration. Leave empty to keep the Script Editing manual/rule-based fallback.
# The server reads these values only; the browser receives configured/model status, never the key.
QWEN_API_KEY=
QWEN_BASE_URL=
# QWEN_API_URL=      # compatibility alias for providers that expose a separate endpoint variable
QWEN_VL_MODEL=qwen-vl-max
QWEN_TEXT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_MODEL_VERSION=unknown
# Optional Jianying encrypted draft runtime.
# Plain JSON drafts do not require these settings.
# Never copy or commit Jianying's proprietary videoeditor.dll into this repository.
JIANYING_VIDEOEDITOR_DLL=
# Optional override for the ContentOS Jianying helper. Leave empty to use the
# bundled build output at tools/jianying-draft-helper/bin on Windows.
JIANYING_DRAFT_HELPER=
