NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://contentos_dev:change-me@127.0.0.1:5432/contentos_dev
STORAGE_ROOT=./storage/local
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_FONT_FILE=C:\Windows\Fonts\msyh.ttc
LOG_LEVEL=info
VIDEO_WORKER_CONCURRENCY=1
PUBLISHER_WORKER_CONCURRENCY=1
