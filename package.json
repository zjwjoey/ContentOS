{
  "name": "contentos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm --filter @contentos/api dev",
    "dev:operator": "tsx scripts/dev-operator.ts",
    "doctor": "tsx scripts/doctor.ts",
    "format": "tsx scripts/format-check.ts --write",
    "format:check": "tsx scripts/format-check.ts",
    "lint": "eslint .",
    "security:scan": "tsx scripts/lint.ts",
    "test:migrations": "tsx --test --test-concurrency=1 tests/integration/migration-matrix.test.ts",
    "test:stage2-contracts": "tsx --test --test-concurrency=1 tests/contract/asset-import.test.ts tests/contract/video-workspace.test.ts tests/e2e/project-navigation-web.test.ts",
    "test:stage2-asset": "tsx --test --test-concurrency=1 tests/integration/asset-import.test.ts tests/integration/asset-api.test.ts tests/worker/asset-worker.test.ts",
    "test:stage2-product": "tsx --test --test-concurrency=1 tests/integration/video-project-read.test.ts tests/integration/video-workspace-api.test.ts tests/integration/approval-list-api.test.ts tests/e2e/video-web.test.ts tests/e2e/approvals-web.test.ts tests/e2e/operator-browser.test.ts",
    "test:browser": "tsx scripts/test-operator-browser.ts",
    "test:integration-closure": "tsx --test --test-concurrency=1 tests/unit/publisher-safety.test.ts tests/unit/publisher-registry.test.ts tests/contract/publisher-real-platform.test.ts tests/contract/browser-session.test.ts tests/contract/douyin-open-api-adapter.test.ts tests/contract/wechat-channels-adapter.test.ts tests/integration/migration-matrix.test.ts tests/integration/publisher-state.test.ts tests/integration/douyin-open-api-adapter.test.ts tests/integration/wechat-channels-adapter.test.ts tests/worker/real-publisher-worker.test.ts",
    "test": "tsx scripts/test-discovery.ts",
    "test:inventory": "tsx scripts/test-discovery.ts --list",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@types/node": "22.15.21",
    "@types/pg": "^8.23.1",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.40.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0",
    "pg-boss": "12.27.0",
    "playwright": "1.62.1",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "sharp": "0.35.0"
    }
  }
}
